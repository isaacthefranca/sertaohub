# BarberSaaS V7 - ambiente local/desenvolvimento
APP_ENV=development
APP_SECRET=dev-only-change-me
APP_BASE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost
CREATE_DEMO_ADMIN=1

# Vazio = SQLite local. Em staging/produção use PostgreSQL.
DATABASE_URL=

# Asaas - PIX e cartão
ASAAS_API_KEY=
ASAAS_SANDBOX=1
ASAAS_WEBHOOK_TOKEN=

# Storage S3/R2. Vazio = arquivos locais (apenas desenvolvimento).
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# E-mail (recuperação de senha). Funciona com qualquer provedor SMTP: Gmail/Workspace,
# Resend (host: smtp.resend.com, user: resend, password: sua API key),
# SendGrid (host: smtp.sendgrid.net, user: apikey, password: sua API key), Mailgun, Amazon SES, etc.
# Vazio = e-mails não são enviados de verdade; o link de redefinição só aparece no log do servidor (modo dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@seudominio.com
SMTP_USE_TLS=1

# Backup PostgreSQL (opcionalmente envia para S3/R2)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_S3_PREFIX=backups
